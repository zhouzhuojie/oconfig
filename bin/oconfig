#!/usr/bin/env bash
# oconfig — save Omarchy customizations into a local git repo.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/oconfig"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/oconfig"
CONFIG_FILE="$CONFIG_DIR/config.json"
IGNORE_FILE="$CONFIG_DIR/ignore.txt"
DEFAULT_IGNORE="$PLUGIN_ROOT/share/ignore.txt"
DEFAULT_REPO="${XDG_DATA_HOME:-$HOME/.local/share}/oconfig/store"
OMARCHY_CONFIG="${OMARCHY_PATH:-/usr/share/omarchy}/config"
# Browser profiles are shipped as a tiny Preferences stub; the live tree is
# hundreds of MB of cookies, cache, and secrets. Never walk it.
SKIP_ROOTS=(chromium)
JSON=0

die() { echo "oconfig: $*" >&2; exit 1; }

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Usage:
  oconfig init [--repo PATH] [--remote URL]
  oconfig check
  oconfig save [-m MSG] [--push]
  oconfig adopt <path>
  oconfig restore [--dry-run]
  oconfig remote [URL]         show or set the optional git remote
  oconfig push                 push the store to origin
  oconfig pull                 fast-forward from origin
  oconfig status
  oconfig diff
  oconfig ignore add <path>

  --json   machine-readable output on check/status/save/restore/push/pull
EOF
}

dump_json() {
  python3 -c 'import json,sys; print(json.dumps(json.loads(sys.argv[1])))' "$1"
}

config_get() {
  local key="$1"
  [[ -f "$CONFIG_FILE" ]] || return 0
  python3 -c 'import json,os,sys
p=json.load(open(sys.argv[1])).get(sys.argv[2],"") or ""
print(os.path.expanduser(p) if sys.argv[2]=="repo" else p)' "$CONFIG_FILE" "$key" 2>/dev/null || true
}

config_set() {
  python3 - "$CONFIG_FILE" "$1" "$2" <<'PY'
import json, os, sys
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
cfg = {}
if os.path.exists(path):
    try:
        cfg = json.load(open(path))
    except Exception:
        cfg = {}
cfg[key] = value
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(cfg, open(path, "w"), indent=2)
print("", end="")
PY
}

repo_path() { config_get repo; }

remote_url() { config_get remote; }

validate_remote() {
  local url="$1"
  [[ -n "$url" ]] || die "empty remote URL"
  [[ "$url" != -* ]] || die "remote URL must not start with -"
  [[ "$url" != *$'\n'* ]] || die "invalid remote URL"
}

git_net() {
  GIT_TERMINAL_PROMPT=0 git "$@"
}

ensure_ignore() {
  mkdir -p "$CONFIG_DIR"
  if [[ ! -f "$IGNORE_FILE" ]]; then
    cp "$DEFAULT_IGNORE" "$IGNORE_FILE"
  fi
}

ignored() {
  local rel="$1"
  [[ "$rel" == *.sample || "$rel" == *.bak || "$rel" == *.bak.* || "$rel" == *.log || "$rel" == *.lock ]] && return 0
  [[ -f "$IGNORE_FILE" ]] || return 1
  local pat
  while IFS= read -r pat; do
    pat="${pat%%#*}"
    pat="${pat%"${pat##*[![:space:]]}"}"
    [[ -z "$pat" ]] && continue
    if [[ "$pat" == */ ]]; then
      [[ "$rel" == "$pat"* || "$rel" == "${pat%/}" ]] && return 0
    else
      [[ "$rel" == "$pat" ]] && return 0
    fi
  done < "$IGNORE_FILE"
  return 1
}

require_repo() {
  local r
  r="$(repo_path)"
  [[ -n "$r" && -d "$r/.git" ]] || die "store not initialized (run: oconfig init)"
  printf '%s\n' "$r"
}

in_store() {
  local repo="$1" rel="$2"
  git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1
}

tracked_paths() {
  local repo="$1"
  git -C "$repo" ls-files -- '.config'
}

git_identity_args() {
  local repo="$1"
  if git -C "$repo" config user.name >/dev/null && git -C "$repo" config user.email >/dev/null; then
    return 0
  fi
  echo -c user.name=oconfig -c user.email=oconfig@localhost
}

commit_if_dirty() {
  local repo="$1" msg="$2"
  git -C "$repo" add -A >/dev/null
  if git -C "$repo" diff --cached --quiet; then
    return 1
  fi
  # shellcheck disable=SC2046
  git -C "$repo" $(git_identity_args "$repo") commit -m "$msg" >/dev/null
  return 0
}

normalize_rel() {
  local p="$1"
  p="${p/#\~/$HOME}"
  if [[ "$p" == "$HOME"/* ]]; then
    p="${p#"$HOME"/}"
  fi
  p="${p#./}"
  printf '%s\n' "$p"
}

skip_root() {
  local name="$1" s
  for s in "${SKIP_ROOTS[@]}"; do
    [[ "$name" == "$s" ]] && return 0
  done
  return 1
}

consider() {
  local rel="$1" live="$2" pkg="$3"
  ignored "$rel" && return 0
  [[ -e "$live" || -L "$live" ]] || return 0
  if [[ -f "$pkg" ]] && cmp -s "$live" "$pkg"; then
    return 0
  fi
  printf '%s\n' "$rel"
}

# Walk every path Omarchy ships under $OMARCHY_CONFIG. New Omarchy config
# folders show up automatically; ~/.config as a whole is not scanned.
scan_customizations() {
  local entry name live_root f rel pkg
  ensure_ignore
  [[ -d "$OMARCHY_CONFIG" ]] || die "Omarchy config not found at $OMARCHY_CONFIG"

  for entry in "$OMARCHY_CONFIG"/*; do
    [[ -e "$entry" ]] || continue
    name="$(basename "$entry")"
    skip_root "$name" && continue

    if [[ -d "$entry" ]]; then
      live_root="$HOME/.config/$name"
      [[ -d "$live_root" ]] || continue
      while IFS= read -r -d '' f; do
        rel=".config/${f#"$HOME/.config/"}"
        pkg="$OMARCHY_CONFIG/${rel#.config/}"
        consider "$rel" "$f" "$pkg"
      done < <(find "$live_root" -xtype f -print0 2>/dev/null)
    elif [[ -f "$entry" ]]; then
      consider ".config/$name" "$HOME/.config/$name" "$entry"
    fi
  done
}

copy_into_store() {
  local repo="$1" rel="$2"
  local live="$HOME/$rel"
  local dest="$repo/$rel"
  [[ -e "$live" || -L "$live" ]] || die "nothing at $live"
  mkdir -p "$(dirname "$dest")"
  cp -aL "$live" "$dest"
}

set_origin() {
  local repo="$1" url="$2"
  validate_remote "$url"
  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    git -C "$repo" remote set-url origin "$url"
  else
    git -C "$repo" remote add origin "$url"
  fi
  config_set remote "$url"
}

cmd_init() {
  local repo="$DEFAULT_REPO" remote=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="${2:-}"; shift 2 ;;
      --remote) remote="${2:-}"; shift 2 ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  repo="${repo/#\~/$HOME}"
  mkdir -p "$CONFIG_DIR" "$STATE_DIR"
  if [[ -n "$remote" && ! -d "$repo/.git" ]]; then
    validate_remote "$remote"
    mkdir -p "$(dirname "$repo")"
    git_net clone -- "$remote" "$repo" || die "failed to clone $remote"
  elif [[ ! -d "$repo/.git" ]]; then
    mkdir -p "$repo"
    git init -q -b main "$repo"
    git -C "$repo" config user.name "$(git config --global user.name 2>/dev/null || echo oconfig)"
    git -C "$repo" config user.email "$(git config --global user.email 2>/dev/null || echo oconfig@localhost)"
  fi
  config_set repo "$repo"
  ensure_ignore
  if ! git -C "$repo" config user.name >/dev/null; then
    git -C "$repo" config user.name "$(git config --global user.name 2>/dev/null || echo oconfig)"
  fi
  if ! git -C "$repo" config user.email >/dev/null; then
    git -C "$repo" config user.email "$(git config --global user.email 2>/dev/null || echo oconfig@localhost)"
  fi
  if [[ -n "$remote" ]]; then
    set_origin "$repo" "$remote"
  fi
  if [[ ! -f "$repo/README.md" ]]; then
    cat > "$repo/README.md" <<EOF
# oconfig store

Omarchy customizations saved by [oconfig](https://github.com/zhouzhuojie/oconfig).
Edit live files under \`~/.config\`, then \`oconfig save\`.
EOF
    git -C "$repo" add README.md
    git -C "$repo" $(git_identity_args "$repo") commit -q -m "oconfig: initialize store" || true
  fi
  echo "initialized store at $repo"
}

cmd_check() {
  local repo=""
  if [[ -f "$CONFIG_FILE" ]]; then
    repo="$(repo_path || true)"
  fi
  local rel paths=()
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    if [[ -n "$repo" && -d "$repo/.git" ]] && in_store "$repo" "$rel"; then
      continue
    fi
    paths+=("$rel")
  done < <(scan_customizations | sort -u)

  if (( JSON )); then
    python3 -c 'import json,sys; print(json.dumps({"untracked": sys.argv[1:], "count": len(sys.argv)-1}))' \
      "${paths[@]+"${paths[@]}"}"
    return
  fi

  if (( ${#paths[@]} == 0 )); then
    echo "ok   no untracked Omarchy customizations"
    return
  fi
  local p
  for p in "${paths[@]}"; do
    echo "$p"
  done
}

cmd_adopt() {
  local rel="${1:-}"
  [[ -n "$rel" ]] || die "usage: oconfig adopt .config/hypr/foo.lua"
  rel="$(normalize_rel "$rel")"
  [[ "$rel" == .config/* ]] || die "only .config/ paths are stored (got $rel)"
  ignored "$rel" && die "$rel is in ignore.txt (machine-local)"
  local repo
  repo="$(require_repo)"
  copy_into_store "$repo" "$rel"
  echo "saved $rel"
}

cmd_save() {
  local msg="oconfig: save customizations" do_push=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message) msg="${2:-}"; shift 2 ;;
      --push) do_push=1; shift ;;
      *) die "unknown save option: $1" ;;
    esac
  done
  local repo
  repo="$(require_repo)"
  local rel saved=()
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    ignored "$rel" && continue
    copy_into_store "$repo" "$rel"
    saved+=("$rel")
  done < <(scan_customizations | sort -u)

  # Also refresh already-tracked files that still exist live.
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]] || continue
    copy_into_store "$repo" "$rel"
  done < <(tracked_paths "$repo")

  local committed=0
  if commit_if_dirty "$repo" "$msg"; then
    committed=1
  fi
  if (( do_push )); then
    cmd_push
  fi

  if (( JSON )); then
    python3 -c 'import json,sys; print(json.dumps({"saved": sys.argv[3:], "committed": sys.argv[1]=="1", "repo": sys.argv[2]}))' \
      "$committed" "$repo" "${saved[@]+"${saved[@]}"}"
    return
  fi

  if (( ${#saved[@]} )); then
    local p
    for p in "${saved[@]}"; do echo "save $p"; done
  fi
  if (( committed )); then
    echo "committed in $repo"
  else
    echo "ok   store already up to date"
  fi
}

cmd_restore() {
  local dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      *) die "unknown restore option: $1" ;;
    esac
  done
  local repo
  repo="$(require_repo)"
  local rel dest bak restored=()
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    dest="$HOME/$rel"
    if (( dry )); then
      echo "would restore $rel"
      restored+=("$rel")
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    if [[ -e "$dest" || -L "$dest" ]]; then
      if ! cmp -s "$repo/$rel" "$dest"; then
        bak="$dest.bak.oconfig.$(date +%s)"
        cp -aL "$dest" "$bak"
      fi
    fi
    # Copy onto a real file. If dest is a symlink, replace it so omarchy
    # refresh cannot write through into the store.
    if [[ -L "$dest" ]]; then
      rm -f "$dest"
    fi
    cp -a "$repo/$rel" "$dest"
    restored+=("$rel")
  done < <(tracked_paths "$repo")

  if (( JSON )); then
    python3 -c 'import json,sys; print(json.dumps({"restored": sys.argv[2:], "dryRun": sys.argv[1]=="1"}))' \
      "$dry" "${restored[@]+"${restored[@]}"}"
    return
  fi

  if (( ${#restored[@]} == 0 )); then
    echo "ok   store is empty — nothing to restore"
    return
  fi
  local p
  for p in "${restored[@]}"; do
    if (( dry )); then echo "would restore $p"; else echo "restored $p"; fi
  done
}

cmd_status() {
  local initialized=0 repo="" dirty=0 untracked=0 ahead=0 behind=0 last="" remote=""
  local untracked_paths=()
  if [[ -f "$CONFIG_FILE" ]]; then
    repo="$(repo_path || true)"
    remote="$(remote_url || true)"
  fi
  if [[ -n "$repo" && -d "$repo/.git" ]]; then
    initialized=1
    if [[ -z "$remote" ]]; then
      remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
    fi
    if ! git -C "$repo" diff --quiet || ! git -C "$repo" diff --cached --quiet; then
      dirty=1
    fi
    last="$(git -C "$repo" log -1 --format='%h %s' 2>/dev/null || true)"
    local ab
    ab="$(git -C "$repo" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || echo '0	0')"
    behind="${ab%%	*}"
    ahead="${ab##*	}"
  fi
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    if [[ "$initialized" -eq 1 ]] && in_store "$repo" "$rel"; then
      continue
    fi
    untracked_paths+=("$rel")
  done < <(scan_customizations 2>/dev/null | sort -u || true)
  untracked=${#untracked_paths[@]}

  if (( JSON )); then
    OCONFIG_INITIALIZED="$initialized" OCONFIG_REPO="$repo" OCONFIG_DIRTY="$dirty" \
    OCONFIG_UNTRACKED="$untracked" OCONFIG_AHEAD="${ahead:-0}" OCONFIG_BEHIND="${behind:-0}" \
    OCONFIG_LAST="$last" OCONFIG_REMOTE="$remote" python3 -c 'import json,os,sys
print(json.dumps({
  "initialized": os.environ.get("OCONFIG_INITIALIZED")=="1",
  "repo": os.environ.get("OCONFIG_REPO",""),
  "remote": os.environ.get("OCONFIG_REMOTE",""),
  "dirty": os.environ.get("OCONFIG_DIRTY")=="1",
  "untracked": int(os.environ.get("OCONFIG_UNTRACKED") or 0),
  "ahead": int(os.environ.get("OCONFIG_AHEAD") or 0),
  "behind": int(os.environ.get("OCONFIG_BEHIND") or 0),
  "lastCommit": os.environ.get("OCONFIG_LAST",""),
  "untrackedPaths": sys.argv[1:],
}))' "${untracked_paths[@]+"${untracked_paths[@]}"}"
    return
  fi

  if (( initialized == 0 )); then
    echo "not initialized — run: oconfig init"
    echo "untracked customizations: $untracked"
    return
  fi
  echo "repo       $repo"
  echo "remote     ${remote:-"(none)"}"
  echo "untracked  $untracked"
  echo "dirty      $dirty"
  echo "ahead      $ahead  behind $behind"
  [[ -n "$last" ]] && echo "HEAD       $last"
}

cmd_remote() {
  local url="${1:-}" repo
  repo="$(require_repo)"
  if [[ -z "$url" ]]; then
    local current
    current="$(git -C "$repo" remote get-url origin 2>/dev/null || remote_url || true)"
    if [[ -z "$current" ]]; then
      echo "no remote configured"
      return
    fi
    echo "$current"
    return
  fi
  set_origin "$repo" "$url"
  echo "remote origin -> $url"
}

cmd_push() {
  local repo url
  repo="$(require_repo)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote) set_origin "$repo" "${2:-}"; shift 2 ;;
      *) die "unknown push option: $1" ;;
    esac
  done
  url="$(git -C "$repo" remote get-url origin 2>/dev/null || remote_url || true)"
  [[ -n "$url" ]] || die "no remote configured (oconfig remote <url>, or set it in the widget)"
  set_origin "$repo" "$url"
  git_net -C "$repo" push -u origin HEAD
  echo "pushed to $url"
}

cmd_pull() {
  local repo url
  repo="$(require_repo)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote) set_origin "$repo" "${2:-}"; shift 2 ;;
      *) die "unknown pull option: $1" ;;
    esac
  done
  url="$(git -C "$repo" remote get-url origin 2>/dev/null || remote_url || true)"
  [[ -n "$url" ]] || die "no remote configured (oconfig remote <url>, or set it in the widget)"
  set_origin "$repo" "$url"
  git_net -C "$repo" fetch origin
  if git -C "$repo" rev-parse --verify '@{upstream}' >/dev/null 2>&1; then
    git_net -C "$repo" pull --ff-only
  else
    local branch
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
    git_net -C "$repo" pull --ff-only origin "$branch" || git_net -C "$repo" pull --ff-only origin main
  fi
  echo "pulled from $url"
}

cmd_diff() {
  local repo
  repo="$(require_repo)"
  local rel
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    if [[ ! -e "$HOME/$rel" ]]; then
      echo "missing live $rel"
      continue
    fi
    if cmp -s "$repo/$rel" "$HOME/$rel"; then
      continue
    fi
    echo "==== $rel ===="
    diff -u "$repo/$rel" "$HOME/$rel" || true
  done < <(tracked_paths "$repo")
}

cmd_ignore_add() {
  local rel="${1:-}"
  [[ -n "$rel" ]] || die "usage: oconfig ignore add .config/hypr/monitors.lua"
  rel="$(normalize_rel "$rel")"
  ensure_ignore
  if grep -Fxq "$rel" "$IGNORE_FILE"; then
    echo "ok   already ignored $rel"
    return
  fi
  echo "$rel" >> "$IGNORE_FILE"
  echo "ignored $rel"
}

# ---- argv ----
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

cmd="${1:-status}"
shift || true

case "$cmd" in
  init) cmd_init "$@" ;;
  check) cmd_check "$@" ;;
  save) cmd_save "$@" ;;
  adopt) cmd_adopt "$@" ;;
  restore) cmd_restore "$@" ;;
  remote) cmd_remote "$@" ;;
  push) cmd_push "$@" ;;
  pull) cmd_pull "$@" ;;
  status) cmd_status "$@" ;;
  diff) cmd_diff "$@" ;;
  ignore)
    sub="${1:-}"; shift || true
    [[ "$sub" == add ]] || die "usage: oconfig ignore add <path>"
    cmd_ignore_add "$@"
    ;;
  *) die "unknown command: $cmd (init|check|save|adopt|restore|remote|push|pull|status|diff|ignore)" ;;
esac
